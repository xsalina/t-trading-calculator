.calculator-pro-guide {
  width: 100%;
  margin: 20rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #F6F8FF;
  border: 1rpx solid rgba(49, 87, 200, 0.12);
  box-sizing: border-box;
}

.pro-guide-brand {
  margin-bottom: 8rpx;
  color: #94A3B8;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.2;
}

.pro-guide-title {
  color: #1F2937;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pro-guide-desc {
  margin-top: 14rpx;
  color: #475467;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pro-guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.pro-guide-tag {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #64748B;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.2;
}

.pro-guide-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 220rpx;
  max-width: 300rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 18rpx auto 0 auto;
  margin-left: auto;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #6F86D8;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
}

.pro-guide-button::after {
  border: none;
}

.pro-guide-button:active {
  background:#6077CC;
}

.pro-guide-tip {
  margin-top: 10rpx;
  color: #98A2B3;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: center;
}
.arrow-right{
  margin-left:10rpx;
}
