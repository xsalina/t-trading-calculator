page {
  background: #F5F7FB;
  color: #24324A;
}

.admin-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.page-title {
  color: #1F2937;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #98A2B3;
  font-size: 23rpx;
}

.refresh {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #EEF3FF;
  color: #3157C8;
  font-size: 24rpx;
  font-weight: 700;
}

.range-scroll,
.sort-scroll {
  width: 100%;
  white-space: nowrap;
}

.range-list,
.sort-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.range-scroll {
  margin-bottom: 20rpx;
}

.range-pill,
.sort-pill {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #64748B;
  border: 1rpx solid #E6EAF2;
  font-size: 24rpx;
  font-weight: 600;
}

.range-pill.active,
.sort-pill.active {
  background: #3157C8;
  border-color: #3157C8;
  color: #FFFFFF;
}

.section-card,
.status-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6EAF2;
  box-sizing: border-box;
}

.status-card {
  color: #64748B;
  text-align: center;
  font-size: 28rpx;
}

.status-card.error {
  color: #D96B6B;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-head.compact {
  display: block;
}

.section-title {
  color: #1F2937;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-desc,
.update-time {
  margin-top: 6rpx;
  color: #98A2B3;
  font-size: 22rpx;
  line-height: 1.35;
}

.update-time {
  text-align: right;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-item {
  min-height: 134rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #F7F8FA;
  box-sizing: border-box;
}

.metric-label {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.3;
}

.metric-value {
  margin-top: 10rpx;
  color: #173B8F;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.metric-desc {
  margin-top: 8rpx;
  color: #98A2B3;
  font-size: 21rpx;
}

.conversion-block {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF2F7;
}

.conversion-title {
  color: #1F2937;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.conversion-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.conversion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #F5F7FB;
  box-sizing: border-box;
}

.conversion-label {
  color: #667085;
  font-size: 21rpx;
}

.conversion-value {
  color: #173B8F;
  font-size: 24rpx;
  font-weight: 800;
}

.funnel-row {
  display: flex;
  align-items: stretch;
  gap: 6rpx;
}

.funnel-item {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  background: #F5F7FB;
  text-align: center;
}

.funnel-label {
  color: #667085;
  font-size: 21rpx;
}

.funnel-value {
  margin-top: 8rpx;
  color: #173B8F;
  font-size: 28rpx;
  font-weight: 800;
}

.funnel-desc {
  margin-top: 4rpx;
  color: #98A2B3;
  font-size: 20rpx;
}

.funnel-arrow {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #94A3B8;
  font-size: 22rpx;
  line-height: 1;
}

.funnel-conversion {
  flex: 0 0 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #98A2B3;
  text-align: center;
}

.funnel-rate {
  color: #3157C8;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
}

.funnel-rate-label {
  margin-top: 3rpx;
  color: #98A2B3;
  font-size: 17rpx;
  line-height: 1.2;
}

.fail-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.fail-pill {
  flex: 1;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #FFF5F5;
  color: #D96B6B;
  font-size: 23rpx;
  font-weight: 600;
}

.sort-scroll {
  margin-top: 16rpx;
}

.ranking-scroll {
  width: 100%;
}

.ranking-table {
  min-width: 1380rpx;
}

.ranking-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #EEF2F7;
}

.ranking-row:last-child {
  border-bottom: none;
}

.ranking-head {
  min-height: 64rpx;
  color: #667085;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-weight: 700;
}

.cell {
  width: 150rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #24324A;
  font-size: 23rpx;
  line-height: 1.35;
}

.cell.name {
  width: 230rpx;
  color: #1F2937;
  font-weight: 700;
}

.cell.rate {
  color: #3157C8;
  font-weight: 700;
}

.empty {
  padding: 28rpx 0 4rpx;
  text-align: center;
  color: #98A2B3;
  font-size: 24rpx;
}
